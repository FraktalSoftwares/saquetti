{
  "expo": {
    "name": "Saquetti Trabalhador",
    "slug": "saquetti-mobile",
    "scheme": "saquetti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.rhexa.trabalhador",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Saquetti usa sua localização para registrar o ponto com precisão."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Saquetti usa a câmera para a foto de verificação no registro de ponto.",
          "recordAudioAndroidPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fe754efe-62a6-4718-b8d7-3ca3bb84e3e7"
      }
    },
    "owner": "lucasandradedev"
  }
}
