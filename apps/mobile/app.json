{
  "expo": {
    "name": "Saquetti Trabalhador",
    "slug": "saquetti-mobile",
    "scheme": "saquetti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Saquetti usa sua localização para registrar o ponto com precisão."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Saquetti usa a câmera para a foto de verificação no registro de ponto."
        }
      ]
    ]
  }
}
