{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [".claude/static-server.js"],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd apps/mobile && CI=1 EXPO_NO_TELEMETRY=1 npx expo start --web ${PORT:+--port $PORT}"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
